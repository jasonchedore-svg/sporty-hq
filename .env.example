# Copy to .env (never commit .env). All keys optional for the fixture demo.
#
# SPORTY_HQ_DATA_DIR=data
# SPORTY_HQ_MIN_EDGE=0.03
# SPORTY_HQ_UNIT_STAKE=25
# SPORTY_HQ_SESSION_STOP=-100
# SPORTY_HQ_MAX_BETS_PER_SESSION=4
# SPORTY_HQ_TARGET_BOOK=fanduel
# SPORTY_HQ_REMIND_MINUTES=45

# Slack incoming webhook (Alerts → Incoming Webhooks). Used by alert-test / scan --alerts / remind.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX

# Generic webhook (JSON POST). Point this at IFTTT Webhooks, a Twilio Function, or n8n/Zapier.
# SPORTY_HQ_WEBHOOK_URL=https://example.com/sporty-hq/hook

# Optional live odds (demo works without this). Never commit the key.
# THE_ODDS_API_KEY=
