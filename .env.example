# Copy to .env (never commit .env). All keys optional for the fixture demo.
#
# SPORTY_HQ_DATA_DIR=data
# SPORTY_HQ_MIN_EDGE=0.03
# SPORTY_HQ_UNIT_STAKE=25
# SPORTY_HQ_SESSION_STOP=-100
# SPORTY_HQ_SEASONAL_STOP=-500
# SPORTY_HQ_SEASON_START=2026-03-20
# SPORTY_HQ_BANKROLL_USD=500
# SPORTY_HQ_KELLY_FRACTION=0
# SPORTY_HQ_KELLY_CAP_UNITS=1
# SPORTY_HQ_MAX_BETS_PER_SESSION=4
# SPORTY_HQ_TARGET_BOOK=fanduel
# SPORTY_HQ_SHARP_BOOK=pinnacle
# SPORTY_HQ_REMIND_MIN_MINUTES=30
# SPORTY_HQ_REMIND_MAX_MINUTES=60
# SPORTY_HQ_CLV_JUDGE_N=100
# SPORTY_HQ_BACKTEST_MIN_N=30
# SPORTY_HQ_PAPER_CONFIRM_DAYS=21
# SPORTY_HQ_PAPER_CONFIRM_MIN_N=12

# v1 alert bus: console + file always. Generic webhook if set.
# SPORTY_HQ_WEBHOOK_URL=https://example.com/sporty-hq/hook

# Later (not required): Slack incoming webhook. No OAuth. Leave unset.
# SPORTY_HQ_ENABLE_SLACK=false
# SLACK_WEBHOOK_URL=

# Payable odds — never commit keys.
# THE_ODDS_API_KEY=
# SPORTSGAMEODDS_API_KEY=
# Leftover / not required (will not be invented for gate 1):
# OPTICODDS_API_KEY=
