{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sporty-hq.local/schemas/bet_log.schema.json",
  "title": "Sporty HQ bet log row",
  "description": "Locked v1 display columns. Time is America/New_York labeled ET.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Time (ET)",
    "Event",
    "Market",
    "Pick",
    "Odds at bet",
    "Stake",
    "Close odds",
    "CLV",
    "Result",
    "P&L",
    "Edge note"
  ],
  "properties": {
    "Time (ET)": { "type": "string" },
    "Event": { "type": "string" },
    "Market": { "type": "string" },
    "Pick": { "type": "string" },
    "Odds at bet": { "type": "integer" },
    "Stake": { "type": "number" },
    "Close odds": { "type": ["integer", "null"] },
    "CLV": {
      "description": "American vs close, same market. Flat line = 0. Positive = beat the close. Judge on ~100+ bets.",
      "type": ["number", "null"]
    },
    "Result": { "type": ["string", "null"] },
    "P&L": { "type": ["number", "null"] },
    "Edge note": { "type": "string" }
  }
}
